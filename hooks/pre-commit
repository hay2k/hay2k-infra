#!/usr/bin/env bash
# infra pre-commit secret scanner (SECRETS_POLICY.md §8).
# Blocks a commit whose STAGED content matches a known credential *format*.
# It matches credential shapes, not the words "password"/"token", so governance
# prose is not flagged. Install: cp hooks/pre-commit .git/hooks/pre-commit
#                                chmod +x .git/hooks/pre-commit
set -euo pipefail

# High-signal credential patterns (extended regex).
patterns=(
  'BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY'   # private key blocks
  'AKIA[0-9A-Z]{16}'                              # AWS access key id
  'ASIA[0-9A-Z]{16}'                              # AWS temp access key id
  'ghp_[A-Za-z0-9]{36}'                           # GitHub personal token
  'github_pat_[0-9A-Za-z_]{22,}'                  # GitHub fine-grained PAT
  'gho_[A-Za-z0-9]{36}'                           # GitHub OAuth token
  'xox[baprs]-[0-9A-Za-z-]{10,}'                  # Slack token
  'AIza[0-9A-Za-z_-]{35}'                         # Google API key
  'sk-[A-Za-z0-9]{20,}'                           # OpenAI-style secret key
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.'   # JWT
  '(secret|token|passwd|password|api[_-]?key|access[_-]?key)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9/+_-]{16,}'  # assigned long value
)

# Only scan added lines in staged text content.
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

hits=0
while IFS= read -r f; do
  # skip the hook itself and binary blobs
  case "$f" in hooks/pre-commit) continue;; esac
  git show ":$f" 2>/dev/null | grep -Iq . || continue   # skip binary
  added=$(git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++')
  for p in "${patterns[@]}"; do
    if printf '%s\n' "$added" | grep -Eq "$p"; then
      echo "BLOCKED: possible secret in '$f' (pattern: $p)" >&2
      hits=$((hits+1))
    fi
  done
done <<< "$staged"

if [ "$hits" -gt 0 ]; then
  echo "" >&2
  echo "Commit blocked by secret-scan ($hits match(es)). See SECRETS_POLICY.md." >&2
  echo "If this is a false positive, review carefully, then: git commit --no-verify" >&2
  exit 1
fi
exit 0
